{
  "title": "Oficina · Plataforma",
  "uid": "oficina-plataforma",
  "tags": [
    "oficina",
    "plataforma",
    "fase-4"
  ],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "servico",
        "label": "Serviço",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "query": "oficina-os-service,oficina-billing-service,oficina-execution-service",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Disponibilidade 24h por serviço",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "avg by (job) (avg_over_time(up{job=~\"$servico\"}[24h])) * 100",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Réplicas ativas (HPA)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"oficina\",horizontalpodautoscaler=~\"$servico\"}",
          "legendFormat": "{{horizontalpodautoscaler}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Latência p95 por serviço",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"$servico\"}[5m])))",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Taxa de erro 5xx por serviço",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "(sum by (job) (rate(http_requests_total{job=~\"$servico\",status=~\"5..\"}[5m])) or (sum by (job) (rate(http_requests_total{job=~\"$servico\"}[5m])) * 0)) / clamp_min(sum by (job) (rate(http_requests_total{job=~\"$servico\"}[5m])), 0.001) * 100",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Latência p95 por rota",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (job, le, route) (rate(http_request_duration_seconds_bucket{job=~\"$servico\"}[5m])))",
          "legendFormat": "{{job}} {{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.50, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"$servico\"}[5m])))",
          "legendFormat": "p50 {{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Throughput por serviço e status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum by (job, status) (rate(http_requests_total{job=~\"$servico\"}[5m]))",
          "legendFormat": "{{job}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "CPU dos pods",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"oficina\",pod=~\"($servico)-.*\",container!=\"\"}[5m]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Memória dos pods",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"oficina\",pod=~\"($servico)-.*\",container!=\"\"})",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Escalabilidade — réplicas vs. CPU",
      "description": "Demonstração do HPA reagindo a carga.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"oficina\",horizontalpodautoscaler=~\"$servico\"}",
          "legendFormat": "réplicas {{horizontalpodautoscaler}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_target_metric{namespace=\"oficina\",horizontalpodautoscaler=~\"$servico\",metric_name=\"cpu\"}",
          "legendFormat": "CPU % {{horizontalpodautoscaler}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Healthchecks — probes reiniciando pods",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"oficina\",pod=~\"($servico)-.*\"}[15m]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Mensageria — outbox e SQS",
      "description": "Mensagens aguardando publicação na outbox e ritmo de publicação no SQS por serviço.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "expr": "sum by (job) (oficina_outbox_pendentes)",
          "legendFormat": "outbox pendente {{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (job) (rate({__name__=~\"oficina_(billing_)?mensagens_publicadas_total\",job=~\"$servico\"}[5m])) * 60",
          "legendFormat": "publicadas/min {{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 11
    }
  ]
}